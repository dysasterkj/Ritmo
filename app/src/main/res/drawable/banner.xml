<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF07090C" android:endColor="#FF0B3D24" android:angle="315" />
        </shape>
    </item>
    <item android:gravity="center" android:width="96dp" android:height="96dp">
        <shape android:shape="oval">
            <solid android:color="#FF1DB954" />
        </shape>
    </item>
    <item android:gravity="center" android:width="30dp" android:height="30dp">
        <shape android:shape="oval">
            <solid android:color="#FF07090C" />
        </shape>
    </item>
</layer-list>
