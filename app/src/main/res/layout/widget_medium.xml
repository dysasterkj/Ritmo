<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="12dp">
    <ImageView android:id="@+id/w_cover" android:layout_width="92dp" android:layout_height="92dp"
        android:scaleType="centerCrop" android:src="@drawable/ic_w_note" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/w_dislike" android:layout_width="38dp" android:layout_height="38dp"
                android:layout_marginEnd="8dp" android:background="@drawable/widget_btn" android:src="@drawable/ic_w_dislike"
                android:padding="8dp" android:contentDescription="No me gusta" />
            <ImageButton android:id="@+id/w_prev" android:layout_width="38dp" android:layout_height="38dp"
                android:background="@drawable/widget_btn" android:src="@drawable/ic_w_prev" android:padding="8dp"
                android:contentDescription="Anterior" />
            <ImageButton android:id="@+id/w_play" android:layout_width="46dp" android:layout_height="46dp"
                android:layout_marginStart="8dp" android:background="@drawable/widget_btn_main"
                android:src="@drawable/ic_w_play" android:padding="10dp" android:contentDescription="Reproducir o pausar" />
            <ImageButton android:id="@+id/w_next" android:layout_width="38dp" android:layout_height="38dp"
                android:layout_marginStart="8dp" android:background="@drawable/widget_btn"
                android:src="@drawable/ic_w_next" android:padding="8dp" android:contentDescription="Siguiente" />
            <ImageButton android:id="@+id/w_like" android:layout_width="38dp" android:layout_height="38dp"
                android:layout_marginStart="8dp" android:background="@drawable/widget_btn"
                android:src="@drawable/ic_w_heart" android:padding="8dp" android:contentDescription="Favorita" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
